# Ixtiyoriy: faqat lug'atdan topilmagan tarjimalar uchun.
# Bu kalit VITE_ bilan boshlanmaydi va brauzerga yuborilmaydi.
TRANSLATE_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ixtiyoriy: Mitticha uchun AI asosidagi kunlik o'qish rejasi.
# Kalitni faqat serverda saqlang; VITE_ bilan boshlamang.
OPENAI_API_KEY=your-openai-server-key-here
OPENAI_MODEL=gpt-4o-mini
API_PORT=3001
